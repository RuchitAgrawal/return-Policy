@{
    ViewData["Title"] = "Customer Return Portal";
}

<div class="container py-3">
    <!-- Header Hero Section -->
    <div class="mb-4 pb-2">
        <span class="fs-micro text-steel d-block mb-1">Customer Self-Service Interface</span>
        <h1 class="hero-display mb-2">Self-Service Return Authorization.</h1>
        <p class="text-charcoal lead mb-0" style="font-size: 1.15rem; max-width: 760px;">
            Cross-reference customer claims against relational SQL order and warranty data.
            AI quantifies sentiment, flags fraud, and routes reverse logistics in real time.
        </p>
    </div>

    <!-- 3 Saturated "Album Cover" Preset Cards (32px Rounded Hero) -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="fs-micro text-steel">Interactive Test Scenarios (1-Click Auto-Fill)</span>
            <span class="text-steel small">Click any tile to pre-load full relational order context</span>
        </div>
        <div class="row g-3">
            <!-- Preset 1: Volcanic Coral -->
            <div class="col-lg-4 col-md-6">
                <div class="card-hero-coral h-100 d-flex flex-column justify-content-between" data-preset="warranty" id="cardPresetWarranty">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="hero-card-tag">Scenario 01 • Active Warranty</span>
                            <span class="badge-pill-dark" style="background: rgba(0,0,0,0.3); font-size: 11px;">ORD-2026-1003</span>
                        </div>
                        <h4 class="fw-bold mb-1">Hardware Failure</h4>
                        <p class="small mb-3" style="opacity: 0.9;">
                            "The Thunderbolt dock keeps disconnecting every 10 minutes and smells like burnt plastic. Need replacement."
                        </p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top border-white border-opacity-25">
                        <span class="small font-mono fw-semibold">B2B Wholesale • ₹18,500</span>
                        <button type="button" class="btn-minimax-white">Auto-Fill</button>
                    </div>
                </div>
            </div>

            <!-- Preset 2: Music Magenta -->
            <div class="col-lg-4 col-md-6">
                <div class="card-hero-magenta h-100 d-flex flex-column justify-content-between" data-preset="remorse" id="cardPresetRemorse">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="hero-card-tag">Scenario 02 • Opened Box Remorse</span>
                            <span class="badge-pill-dark" style="background: rgba(0,0,0,0.3); font-size: 11px;">ORD-2026-1001</span>
                        </div>
                        <h4 class="fw-bold mb-1">15% Restocking Fee</h4>
                        <p class="small mb-3" style="opacity: 0.9;">
                            "Opened the box and tried keyboard for a week, but don't like the tactile switch sound. Want full refund."
                        </p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top border-white border-opacity-25">
                        <span class="small font-mono fw-semibold">Shopify • ₹9,500</span>
                        <button type="button" class="btn-minimax-white">Auto-Fill</button>
                    </div>
                </div>
            </div>

            <!-- Preset 3: Hailuo Deep Blue -->
            <div class="col-lg-4 col-md-12">
                <div class="card-hero-blue h-100 d-flex flex-column justify-content-between" data-preset="fraud" id="cardPresetFraud">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="hero-card-tag">Scenario 03 • Suspected Fraud</span>
                            <span class="badge-pill-dark" style="background: rgba(0,0,0,0.3); font-size: 11px;">ORD-2026-1002</span>
                        </div>
                        <h4 class="fw-bold mb-1">Abuse & Quarantine</h4>
                        <p class="small mb-3" style="opacity: 0.9;">
                            "Dropped monitor down stairs while moving, screen shattered. Replace under warranty or I'll post bad reviews!"
                        </p>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top border-white border-opacity-25">
                        <span class="small font-mono fw-semibold">Amazon IN • ₹38,000</span>
                        <button type="button" class="btn-minimax-white">Auto-Fill</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Working Grid: Form vs Live Result -->
    <div class="row g-4">
        <!-- Left: Form Controls (Quiet White Card Family) -->
        <div class="col-lg-7">
            <!-- Step 1: Order Lookup -->
            <div class="card-base mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fs-micro text-steel">Step 01 / Order Lookup</span>
                    <span class="badge-pill-neutral">Relational SQL Sync</span>
                </div>
                
                <div class="input-group mb-2">
                    <input type="text" id="orderNumberInput" class="form-control form-control-minimax" placeholder="Enter Order Number (e.g. ORD-2026-1001)" />
                    <button class="btn-minimax-primary ms-2" id="btnLookupOrder">
                        <span class="spinner-border spinner-border-sm me-1 d-none" id="lookupSpinner"></span>
                        Find Order
                    </button>
                </div>
                <div id="lookupAlert" class="mt-2 text-danger small d-none"></div>

                <div class="d-flex align-items-center gap-2 mt-3 pt-3 border-top border-light-subtle">
                    <span class="small text-steel">Seeded Orders:</span>
                    <select id="demoOrderSelect" class="form-select form-select-sm" style="max-width: 320px; font-size: 13px;">
                        <option value="">Quick pick order...</option>
                        <option value="ORD-2026-1001">ORD-2026-1001 (5d ago, Shopify, Keyboard)</option>
                        <option value="ORD-2026-1002">ORD-2026-1002 (22d ago, AmazonIN, 4K Monitor)</option>
                        <option value="ORD-2026-1003">ORD-2026-1003 (75d ago, B2B, 10x TB4 Docks)</option>
                        <option value="ORD-2026-1004">ORD-2026-1004 (410d ago, DirectWeb, Expired Webcam)</option>
                        <option value="ORD-2026-1005">ORD-2026-1005 (2d ago, Shopify, 4K Monitor)</option>
                    </select>
                </div>
            </div>

            <!-- Feature 2: Interactive Return Policy Sandbox / Simulator -->
            <div class="card-surface mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fs-micro text-steel">Interactive Policy Simulator</span>
                    <span class="badge-pill-dark font-mono" id="sliderDaysDisplay">75 Days Ago</span>
                </div>
                <p class="small text-steel mb-3">
                    Drag the delivery window slider to test the deterministic C# policy engine calculations in real time.
                </p>
                <input type="range" class="form-range" id="policySandboxSlider" min="1" max="420" value="75">
                <div class="d-flex justify-content-between fs-micro text-steel mt-1 mb-3">
                    <span>Day 1 (Recent)</span>
                    <span>Day 30 (Cutoff)</span>
                    <span>Day 365 (Warranty)</span>
                    <span>Day 420 (Expired)</span>
                </div>
                <div class="p-3 bg-white rounded-3 border border-light-subtle d-flex flex-wrap gap-2 align-items-center justify-content-between">
                    <div>
                        <span class="small text-steel d-block">Simulated Window Eligibility:</span>
                        <span class="fw-semibold small" id="simulatedWindowNote">Warranty Coverage Active</span>
                    </div>
                    <div class="d-flex gap-2" id="simulatedBadgesContainer">
                        <span class="badge-pill-success" id="simWarrantyBadge">In Warranty</span>
                        <span class="badge-pill-neutral" id="simReturnBadge">30-Day Window Closed</span>
                    </div>
                </div>
            </div>

            <!-- Step 2: Line Item Selection (Populated by JS) -->
            <div class="card-base mb-4 d-none" id="step2Container">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fs-micro text-steel">Step 02 / Item Selection</span>
                    <span class="badge-pill-neutral font-mono" id="orderMetaBadge"></span>
                </div>
                <div id="lineItemsContainer" class="d-flex flex-column gap-2 mb-2"></div>
            </div>

            <!-- Step 3: Return Form & Evidence Upload -->
            <div class="card-base d-none" id="step3Container">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fs-micro text-steel">Step 03 / Complaint & Proof</span>
                    <span class="badge-pill-neutral">LLM Grounding</span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fs-micro text-steel mb-1">Customer Condition</label>
                        <select id="conditionSelect" class="form-select form-select-minimax">
                            <option value="Unopened">Unopened (Factory Sealed)</option>
                            <option value="OpenedUnused">Opened / Like New (Unused)</option>
                            <option value="Defective" selected>Defective / Malfunctioning</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fs-micro text-steel mb-1">Requested Resolution</label>
                        <select id="resolutionSelect" class="form-select form-select-minimax">
                            <option value="Refund">Full or Prorated Refund</option>
                            <option value="Replacement" selected>Product Replacement</option>
                            <option value="StoreCredit">Store Credit</option>
                        </select>
                    </div>
                </div>

                <!-- Feature 4: Drag & Drop Photo Evidence Upload Simulation -->
                <div class="mb-3">
                    <label class="form-label fs-micro text-steel mb-1">Product Photo or Proof (Optional)</label>
                    <div class="upload-dropzone" id="uploadDropzone">
                        <i class="bi bi-cloud-arrow-up fs-2 text-steel d-block mb-1"></i>
                        <span class="fw-semibold small d-block">Drag product damage photo here, or click to browse</span>
                        <span class="fs-micro text-steel">JPEG, PNG up to 25MB</span>
                        <input type="file" id="evidenceFileInput" class="d-none" accept="image/*">
                    </div>
                    <div id="uploadPreviewContainer" class="p-2 border rounded-3 mt-2 d-none align-items-center justify-content-between bg-light">
                        <div class="d-flex align-items-center gap-2">
                            <img id="evidenceImagePreview" src="" alt="Proof" style="width: 44px; height: 44px; object-fit: cover; border-radius: 6px;">
                            <div>
                                <span class="fw-semibold small d-block" id="evidenceFileName">proof.png</span>
                                <span class="badge-pill-success py-0 px-2" style="font-size: 11px;">Proof Attached</span>
                            </div>
                        </div>
                        <button type="button" class="btn-minimax-tertiary py-1 px-3" id="btnRemoveEvidence">Remove</button>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="complaintText" class="form-label fs-micro text-steel mb-1">Customer Complaint (Unstructured Text)</label>
                    <textarea id="complaintText" class="form-control form-control-minimax" rows="4" placeholder="Describe the product malfunction, damage, or return reason in plain words..."></textarea>
                </div>

                <button class="btn-minimax-primary w-100 py-3" id="btnSubmitRma">
                    <i class="bi bi-cpu fs-6"></i>
                    <span>Submit for Structured AI Triage</span>
                </button>
            </div>
        </div>

        <!-- Right: AI Triage Structured Assessment & Carrier Slip -->
        <div class="col-lg-5">
            <!-- Loading State -->
            <div class="card-base p-5 text-center d-none" id="loadingPanel">
                <div class="spinner-border text-dark mb-3" style="width: 2.75rem; height: 2.75rem;" role="status"></div>
                <h5 class="fw-bold mb-1">Executing Structured AI Triage</h5>
                <p class="text-steel small mb-0">Cross-referencing delivery dates in SQL and evaluating fraud risk markers...</p>
            </div>

            <!-- Empty Placeholder -->
            <div class="card-surface p-5 text-center" id="emptyResultPlaceholder">
                <div class="text-steel mb-3" style="opacity: 0.35;">
                    <i class="bi bi-shield-check" style="font-size: 3.5rem;"></i>
                </div>
                <h6 class="fw-bold mb-1">No Active Triage Result</h6>
                <p class="text-steel small mb-0">Select an order line item and submit a complaint to generate a structured AI policy audit.</p>
            </div>

            <!-- Result Card Container -->
            <div class="card-base d-none" id="resultContainer">
                <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom border-light-subtle">
                    <div>
                        <span class="fs-micro text-steel font-mono d-block" id="resTicketNumber">RMA-0000</span>
                        <h5 class="fw-bold mb-0">Audit Assessment</h5>
                    </div>
                    <span class="badge-pill-dark" id="resStatusBadge">Status</span>
                </div>

                <!-- Financial Breakdown -->
                <div class="p-3 bg-light rounded-3 mb-3">
                    <div class="row g-2 text-center">
                        <div class="col-6 border-end border-light-subtle">
                            <span class="fs-micro text-steel d-block">Eligible Refund</span>
                            <span class="fw-bold text-success fs-5 font-mono" id="resRefundAmount">₹0.00</span>
                        </div>
                        <div class="col-6">
                            <span class="fs-micro text-steel d-block">Restocking Fee</span>
                            <span class="fw-bold text-danger fs-5 font-mono" id="resRestockingFee">₹0.00</span>
                        </div>
                    </div>
                </div>

                <!-- AI Extracted Properties -->
                <div class="d-flex flex-column gap-2 mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-steel">Defect Category:</span>
                        <span class="badge-pill-neutral font-mono" id="resDefectCategory">--</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-steel">Fraud Risk:</span>
                        <span class="badge-pill-dark" id="resFraudRiskBadge">--</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-steel">Recommendation:</span>
                        <span class="badge-pill-neutral fw-semibold" id="resRecommendedAction">--</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-steel">Warehouse Routing:</span>
                        <span class="badge-pill-dark" id="resRoutingAction">--</span>
                    </div>
                </div>

                <!-- Sentiment Gauge -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center small mb-1">
                        <span class="text-steel">Frustration / Escalation Score:</span>
                        <span class="fw-bold font-mono" id="resSentimentValue">0/10</span>
                    </div>
                    <div class="sentiment-gauge-editorial">
                        <div class="sentiment-fill-editorial" id="resSentimentFill" style="width: 0%;"></div>
                    </div>
                </div>

                <!-- AI Reasoning Summary -->
                <div class="mb-3">
                    <label class="fs-micro text-steel d-block mb-1">Audit Reasoning</label>
                    <div class="p-2.5 bg-light rounded-3 small text-charcoal" id="resReasoningText"></div>
                </div>

                <!-- Drafted Customer Email -->
                <div class="mb-4">
                    <label class="fs-micro text-steel d-block mb-1">Drafted Customer Communication</label>
                    <textarea class="form-control form-control-minimax small font-mono bg-light" id="resDraftedEmail" rows="3" readonly></textarea>
                </div>

                <!-- Feature 1: Trigger Carrier Return Shipping Label -->
                <button type="button" class="btn-minimax-secondary w-100" id="btnOpenCarrierLabel">
                    <i class="bi bi-printer me-1"></i>
                    <span>Generate Carrier Shipping Slip</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Feature 1: Carrier Return Shipping Label Modal -->
<div class="modal fade" id="carrierLabelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 p-3" style="border-radius: 20px;">
            <div class="d-flex justify-content-between align-items-center mb-3 px-2">
                <span class="fs-micro text-steel">Reverse Logistics Manifest</span>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Authentic 4x6 Carrier Slip -->
            <div class="carrier-label-sheet" id="printableCarrierSlip">
                <div class="carrier-header d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold mb-0" style="letter-spacing: -1px;">DELHIVERY EXPRESS</h4>
                        <span class="fs-micro text-uppercase">Priority Reverse Cargo</span>
                    </div>
                    <div class="text-end">
                        <span class="badge-pill-dark py-1 px-2 font-mono" id="labelRmaNumber">RMA-9002</span>
                    </div>
                </div>

                <div class="row g-2 small mb-2">
                    <div class="col-6">
                        <span class="text-steel fs-micro d-block">DELIVER TO HUB:</span>
                        <span class="fw-bold d-block">ReturnFlow Hub #4</span>
                        <span>Whitefield Logistics Park</span>
                        <span class="d-block">Bengaluru, KA 560066</span>
                    </div>
                    <div class="col-6 border-start ps-2">
                        <span class="text-steel fs-micro d-block">PICKUP FROM:</span>
                        <span class="fw-bold d-block" id="labelCustomerName">Aarav Sharma</span>
                        <span class="d-block" id="labelOrderRef">Order ORD-2026-1001</span>
                        <span class="text-steel fs-micro">Authorized Return</span>
                    </div>
                </div>

                <div class="p-2 bg-light border border-dark rounded-2 small mb-2">
                    <div class="d-flex justify-content-between">
                        <span class="text-steel">Product:</span>
                        <span class="fw-bold font-mono" id="labelProductSku">SKU-DOCK-TB4</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-steel">Routing:</span>
                        <span class="fw-bold text-uppercase" id="labelRoutingAction">SEND TO REFURBISH</span>
                    </div>
                </div>

                <!-- Code-128 SVG Barcode Representation -->
                <div class="carrier-barcode-zone">
                    <svg width="280" height="50" viewBox="0 0 280 50" xmlns="http://www.w3.org/2000/svg">
                        <rect x="0" y="0" width="4" height="50" fill="#000" />
                        <rect x="8" y="0" width="2" height="50" fill="#000" />
                        <rect x="14" y="0" width="6" height="50" fill="#000" />
                        <rect x="24" y="0" width="2" height="50" fill="#000" />
                        <rect x="30" y="0" width="4" height="50" fill="#000" />
                        <rect x="38" y="0" width="8" height="50" fill="#000" />
                        <rect x="50" y="0" width="2" height="50" fill="#000" />
                        <rect x="56" y="0" width="6" height="50" fill="#000" />
                        <rect x="66" y="0" width="4" height="50" fill="#000" />
                        <rect x="74" y="0" width="2" height="50" fill="#000" />
                        <rect x="80" y="0" width="8" height="50" fill="#000" />
                        <rect x="92" y="0" width="4" height="50" fill="#000" />
                        <rect x="100" y="0" width="6" height="50" fill="#000" />
                        <rect x="110" y="0" width="2" height="50" fill="#000" />
                        <rect x="116" y="0" width="4" height="50" fill="#000" />
                        <rect x="124" y="0" width="8" height="50" fill="#000" />
                        <rect x="136" y="0" width="2" height="50" fill="#000" />
                        <rect x="142" y="0" width="6" height="50" fill="#000" />
                        <rect x="152" y="0" width="4" height="50" fill="#000" />
                        <rect x="160" y="0" width="2" height="50" fill="#000" />
                        <rect x="166" y="0" width="8" height="50" fill="#000" />
                        <rect x="178" y="0" width="4" height="50" fill="#000" />
                        <rect x="186" y="0" width="6" height="50" fill="#000" />
                        <rect x="196" y="0" width="2" height="50" fill="#000" />
                        <rect x="202" y="0" width="4" height="50" fill="#000" />
                        <rect x="210" y="0" width="8" height="50" fill="#000" />
                        <rect x="222" y="0" width="4" height="50" fill="#000" />
                        <rect x="230" y="0" width="6" height="50" fill="#000" />
                        <rect x="240" y="0" width="2" height="50" fill="#000" />
                        <rect x="246" y="0" width="6" height="50" fill="#000" />
                        <rect x="256" y="0" width="4" height="50" fill="#000" />
                        <rect x="264" y="0" width="8" height="50" fill="#000" />
                    </svg>
                    <span class="font-mono fs-micro d-block mt-1" id="labelBarcodeText">*DEL-RMA-9002-EXPEDITED*</span>
                </div>

                <div class="d-flex justify-content-between align-items-center fs-micro text-steel">
                    <span>TRACKING: DEL99214482IN</span>
                    <span>WEIGHT: 1.85 KG</span>
                    <span>STANDARD REVERSE CARGO</span>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-end mt-3">
                <button type="button" class="btn-minimax-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn-minimax-primary" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Print Label
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/rma-portal.js" asp-append-version="true"></script>
}
