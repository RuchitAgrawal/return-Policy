@{
    ViewData["Title"] = "Customer Return Portal";
}

<div class="container py-3">
    <!-- Header banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1">Customer Self-Service Return Portal</h1>
            <p class="text-muted mb-0">Submit unstructured return requests for instant AI policy verification and RMA routing.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label for="demoOrderSelect" class="form-label mb-0 small text-muted text-nowrap fw-semibold">
                <i class="bi bi-magic me-1"></i> Quick Fill Demo Order:
            </label>
            <select id="demoOrderSelect" class="form-select form-select-sm" style="min-width: 260px;">
                <option value="">-- Choose a Seeded Order --</option>
                <option value="ORD-2026-1001">ORD-2026-1001 (5d ago - Shopify - Keyboard/Audio)</option>
                <option value="ORD-2026-1002">ORD-2026-1002 (22d ago - AmazonIN - 4K Monitor)</option>
                <option value="ORD-2026-1003">ORD-2026-1003 (75d ago - B2B Wholesale - Docks)</option>
                <option value="ORD-2026-1004">ORD-2026-1004 (410d ago - DirectWeb - Expired Webcam)</option>
                <option value="ORD-2026-1005">ORD-2026-1005 (2d ago - Shopify - 4K Monitor)</option>
            </select>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left: Form Steps -->
        <div class="col-lg-7">
            <!-- Step 1: Order Lookup -->
            <div class="rf-card p-4 mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-primary text-white rounded-pill px-2.5 py-1">Step 1</span>
                    <h5 class="fw-bold mb-0">Find Your Order</h5>
                </div>
                
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" id="orderNumberInput" class="form-control" placeholder="Enter Order Number (e.g. ORD-2026-1001)" />
                    <button class="btn btn-primary px-4 fw-semibold" id="btnLookupOrder">
                        <span class="spinner-border spinner-border-sm me-1 d-none" id="lookupSpinner"></span>
                        Lookup Order
                    </button>
                </div>
                <div id="lookupAlert" class="mt-2 text-danger small d-none"></div>
            </div>

            <!-- Step 2: Line Item Selection (Dynamically populated) -->
            <div class="rf-card p-4 mb-4 d-none" id="step2Container">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary text-white rounded-pill px-2.5 py-1">Step 2</span>
                        <h5 class="fw-bold mb-0">Select Item to Return</h5>
                    </div>
                    <span class="badge bg-secondary-subtle text-secondary" id="orderMetaBadge"></span>
                </div>

                <div id="lineItemsContainer" class="d-flex flex-column gap-2 mb-3">
                    <!-- Injected by rma-portal.js -->
                </div>
            </div>

            <!-- Step 3: Return Details & Complaint -->
            <div class="rf-card p-4 d-none" id="step3Container">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-primary text-white rounded-pill px-2.5 py-1">Step 3</span>
                    <h5 class="fw-bold mb-0">Return Reason & Condition</h5>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Item Condition</label>
                        <select id="conditionSelect" class="form-select">
                            <option value="Unopened">Unopened (Factory Sealed)</option>
                            <option value="OpenedUnused">Opened / Like New (Unused)</option>
                            <option value="Defective" selected>Defective / Malfunctioning</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Requested Resolution</label>
                        <select id="resolutionSelect" class="form-select">
                            <option value="Refund">Full or Prorated Refund</option>
                            <option value="Replacement" selected>Product Replacement</option>
                            <option value="StoreCredit">Store Credit</option>
                        </select>
                    </div>
                </div>

                <!-- Preset Complaint Pills -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted d-block">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick Test Scenarios (Click to Fill):
                    </label>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="preset-pill" data-preset="warranty">
                            <i class="bi bi-shield-check text-success me-1"></i> 1. Legitimate Warranty Defect
                        </button>
                        <button type="button" class="preset-pill" data-preset="remorse">
                            <i class="bi bi-bag-x text-primary me-1"></i> 2. Buyer's Remorse (Opened)
                        </button>
                        <button type="button" class="preset-pill" data-preset="fraud">
                            <i class="bi bi-exclamation-triangle text-danger me-1"></i> 3. Suspected Fraud / Abuse
                        </button>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="complaintText" class="form-label small fw-semibold text-muted">Describe the Issue (Unstructured Customer Complaint)</label>
                    <textarea id="complaintText" class="form-control" rows="4" placeholder="Explain what happened with the product in plain words..."></textarea>
                </div>

                <button class="btn btn-primary w-100 py-2.5 fw-bold d-flex align-items-center justify-content-center gap-2" id="btnSubmitRma">
                    <i class="bi bi-cpu fs-5"></i>
                    <span>Submit for AI Policy & Fraud Triage</span>
                </button>
            </div>
        </div>

        <!-- Right: AI Triage Live Result Panel -->
        <div class="col-lg-5">
            <!-- Loading State -->
            <div class="rf-card p-5 text-center d-none" id="loadingPanel">
                <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
                <h5 class="fw-bold mb-1">Running AI Policy & Fraud Triage...</h5>
                <p class="text-muted small mb-0">Cross-referencing SQL warranty rules and evaluating complaint sentiment & fraud signals.</p>
            </div>

            <!-- Empty Placeholder -->
            <div class="rf-card p-5 text-center" id="emptyResultPlaceholder">
                <div class="text-muted mb-3 opacity-50">
                    <i class="bi bi-shield-shaded" style="font-size: 3.5rem;"></i>
                </div>
                <h6 class="fw-bold mb-2">No Active Triage Result</h6>
                <p class="text-muted small mb-0">Look up an order, select a line item, and submit a complaint to view the real-time AI structured triage decision.</p>
            </div>

            <!-- Result Card Container -->
            <div class="rf-card p-4 d-none" id="resultContainer">
                <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                    <div>
                        <span class="text-muted small font-mono d-block" id="resTicketNumber">RMA-0000</span>
                        <h5 class="fw-bold mb-0">Triage Assessment</h5>
                    </div>
                    <span class="badge rounded-pill px-3 py-1.5" id="resStatusBadge">Status</span>
                </div>

                <!-- Financial / Eligibility Ribbon -->
                <div class="bg-light p-3 rounded-3 mb-3">
                    <div class="row g-2 text-center">
                        <div class="col-6 border-end">
                            <span class="text-muted small d-block">Eligible Refund</span>
                            <span class="fw-bold text-success fs-5" id="resRefundAmount">₹0.00</span>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small d-block">Restocking Fee</span>
                            <span class="fw-bold text-danger fs-5" id="resRestockingFee">₹0.00</span>
                        </div>
                    </div>
                </div>

                <!-- AI Extraction Badges -->
                <div class="d-flex flex-column gap-2 mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted fw-semibold">Defect Category:</span>
                        <span class="badge bg-light text-dark border" id="resDefectCategory">--</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted fw-semibold">Fraud Risk Level:</span>
                        <span class="badge" id="resFraudRiskBadge">--</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted fw-semibold">Recommended Action:</span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle" id="resRecommendedAction">--</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted fw-semibold">Warehouse Routing:</span>
                        <span class="badge bg-secondary text-white" id="resRoutingAction">--</span>
                    </div>
                </div>

                <!-- Sentiment Gauge -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center small mb-1">
                        <span class="text-muted fw-semibold">Customer Sentiment / Escalation Risk:</span>
                        <span class="fw-bold font-mono" id="resSentimentValue">0/10</span>
                    </div>
                    <div class="sentiment-gauge">
                        <div class="sentiment-fill" id="resSentimentFill" style="width: 0%;"></div>
                    </div>
                </div>

                <!-- AI Reasoning Summary -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted mb-1">AI Audit Reasoning</label>
                    <div class="p-2.5 bg-light rounded-3 small text-secondary" id="resReasoningText"></div>
                </div>

                <!-- Drafted Email -->
                <div>
                    <label class="form-label small fw-semibold text-muted mb-1">Drafted Customer Communication</label>
                    <textarea class="form-control small font-mono bg-light text-dark" id="resDraftedEmail" rows="4" readonly></textarea>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/rma-portal.js" asp-append-version="true"></script>
}
