@inject ReturnFlow.Core.Interfaces.IAiTriageService AiService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ReturnFlow AI</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- Custom Enterprise Theme -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-surface text-main">
    <nav class="navbar navbar-expand-lg navbar-dark bg-slate border-bottom border-secondary-subtle sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="/">
                <span class="brand-icon d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3">
                    <i class="bi bi-arrow-repeat fs-5"></i>
                </span>
                <span>ReturnFlow <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-xs">AI</span></span>
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                    <li class="nav-item">
                        <a class="nav-link text-nav fw-medium @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rma" ? "active" : "")" href="/Rma/Submit">
                            <i class="bi bi-box-arrow-in-left me-1"></i> Customer Portal
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-nav fw-medium @(ViewContext.RouteData.Values["controller"]?.ToString() == "Staff" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" href="/Staff/Dashboard">
                            <i class="bi bi-kanban me-1"></i> Staff Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-nav fw-medium @(ViewContext.RouteData.Values["controller"]?.ToString() == "Staff" && ViewContext.RouteData.Values["action"]?.ToString() == "Inventory" ? "active" : "")" href="/Staff/Inventory">
                            <i class="bi bi-layers me-1"></i> Inventory Ledger
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-nav fw-medium" href="/swagger" target="_blank">
                            <i class="bi bi-code-square me-1"></i> Swagger API
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3">
                    @if (AiService.IsLiveMode)
                    {
                        <span class="badge rounded-pill bg-success-subtle text-success border border-success px-3 py-2 d-inline-flex align-items-center gap-2">
                            <span class="pulse-dot bg-success"></span>
                            <span class="fw-semibold">Live OpenAI Active</span>
                        </span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-warning-subtle text-warning-emphasis border border-warning px-3 py-2 d-inline-flex align-items-center gap-2" title="Zero-config deterministic fallback enabled. Set OPENAI_API_KEY to activate live LLM.">
                            <span class="pulse-dot bg-warning"></span>
                            <span class="fw-semibold">Zero-Config Mock AI</span>
                        </span>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="py-4">
        @RenderBody()
    </main>

    <!-- Global Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer" style="z-index: 1100;"></div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
