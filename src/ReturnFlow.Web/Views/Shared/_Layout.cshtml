@inject ReturnFlow.Core.Interfaces.IAiTriageService AiService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ReturnFlow</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts: DM Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- Chart.js CDN for Minimalist Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <!-- MiniMax Editorial Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Stark White Clean Navbar -->
    <nav class="navbar navbar-expand-lg navbar-minimax sticky-top">
        <div class="container-fluid px-lg-4 px-3">
            <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="/">
                <span class="navbar-brand-mark">
                    <i class="bi bi-box-seam-fill fs-6"></i>
                </span>
                <span class="fw-bold text-dark" style="letter-spacing: -0.5px; font-size: 18px;">
                    ReturnFlow
                </span>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                    <li class="nav-item">
                        <a class="nav-link nav-link-minimax @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rma" ? "active" : "")" href="/Rma/Submit">
                            <i class="bi bi-box-arrow-in-left me-1"></i> Customer Portal
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-minimax @(ViewContext.RouteData.Values["controller"]?.ToString() == "Staff" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" href="/Staff/Dashboard">
                            <i class="bi bi-kanban me-1"></i> Returns Queue
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-minimax @(ViewContext.RouteData.Values["controller"]?.ToString() == "Staff" && ViewContext.RouteData.Values["action"]?.ToString() == "Inventory" ? "active" : "")" href="/Staff/Inventory">
                            <i class="bi bi-layers me-1"></i> Inventory Ledger
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-minimax" href="/swagger" target="_blank">
                            <i class="bi bi-terminal me-1"></i> API Docs
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <span class="badge-pill-neutral font-mono small text-steel px-3 py-1.5 d-none d-md-inline-flex align-items-center">
                        <i class="bi bi-building me-1.5 text-steel"></i> Fulfillment Hub #04
                    </span>
                    <a href="/swagger" class="btn-minimax-tertiary" title="API Explorer" style="padding: 6px 14px; font-size: 13px;">
                        <i class="bi bi-code-slash me-1"></i> API
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Canvas -->
    <main class="py-4 flex-grow-1">
        @RenderBody()
    </main>

    <!-- Clean Enterprise Footer -->
    <footer class="border-top py-3 mt-auto bg-white">
        <div class="container-fluid px-lg-4 px-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-steel">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-semibold text-dark">ReturnFlow</span>
                <span>•</span>
                <span>Reverse Logistics & Multichannel Inventory Engine</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="d-inline-flex align-items-center gap-1.5">
                    <span class="pulse-dot bg-success" style="width: 6px; height: 6px; border-radius: 50%;"></span>
                    <span>System Operational</span>
                </span>
                <span>•</span>
                <a href="https://github.com/RuchitAgrawal/return-Policy" target="_blank" class="text-steel text-decoration-none">
                    <i class="bi bi-github me-1"></i> Repository
                </a>
            </div>
        </div>
    </footer>

    <!-- Global Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer" style="z-index: 1100;"></div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
