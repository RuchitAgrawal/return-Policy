@model List<ReturnFlow.Core.DTOs.InventorySummaryDto>
@{
    ViewData["Title"] = "Live Inventory Ledger";
}

<div class="container-fluid px-lg-4 px-3 py-3">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-2">
        <div>
            <span class="fs-micro text-steel d-block mb-1">Warehouse Operations Command</span>
            <h1 class="heading-lg mb-0">Live Stock & Reverse Logistics Ledger</h1>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <a href="/Staff/Dashboard" class="btn-minimax-secondary text-decoration-none">
                <i class="bi bi-arrow-left me-1"></i> Triage Command
            </a>
            <a href="/Rma/Submit" class="btn-minimax-primary text-decoration-none">
                <i class="bi bi-plus-circle me-1"></i> Customer Portal
            </a>
        </div>
    </div>

    <div class="card-base p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table-minimax align-middle">
                <thead>
                    <tr>
                        <th>Product / SKU</th>
                        <th>Category</th>
                        <th>Unit Price (INR)</th>
                        <th>Warranty Window</th>
                        <th class="text-center">Sellable Stock</th>
                        <th class="text-center">Damaged / RMA Stock</th>
                        <th>Return Rate Exposure</th>
                        <th>Stock Health</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var returnRateColor = p.ReturnRatePercent > 10m ? "text-danger" : (p.ReturnRatePercent > 0m ? "text-dark" : "text-success");
                        <tr>
                            <td>
                                <div class="fw-semibold text-dark">@p.Name</div>
                                <span class="font-mono text-steel small">@p.Sku</span>
                            </td>
                            <td>
                                <span class="badge-pill-neutral font-mono">@p.Category</span>
                            </td>
                            <td class="font-mono fw-semibold">
                                ₹@p.UnitPrice.ToString("N2")
                            </td>
                            <td>
                                <span class="text-steel small">@p.WarrantyDays days</span>
                            </td>
                            <td class="text-center">
                                <span class="badge-pill-dark font-mono px-3 py-1">
                                    @p.CurrentStockOnHand
                                </span>
                            </td>
                            <td class="text-center">
                                @if (p.DamagedStockCount > 0)
                                {
                                    <span class="badge-pill-coral font-mono px-3 py-1">
                                        @p.DamagedStockCount
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-pill-neutral font-mono px-3 py-1 text-steel">
                                        0
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2" style="max-width: 180px;">
                                    <div class="progress flex-grow-1" style="height: 5px; background: #e2e8f0; border-radius: 9999px;">
                                        <div class="progress-bar @(p.ReturnRatePercent > 10 ? "bg-danger" : "bg-dark")" 
                                             role="progressbar" 
                                             style="width: @Math.Min(100, p.ReturnRatePercent * 3)%; border-radius: 9999px;"></div>
                                    </div>
                                    <span class="font-mono fw-bold @returnRateColor small">@p.ReturnRatePercent%</span>
                                </div>
                                <span class="text-steel fs-micro d-block mt-0.5">@p.ApprovedRmaCount approved / @p.TotalRmaCount total RMAs</span>
                            </td>
                            <td>
                                @if (p.CurrentStockOnHand > 50)
                                {
                                    <span class="badge-pill-neutral text-success">
                                        <i class="bi bi-check2-circle me-1"></i> Optimal Stock
                                    </span>
                                }
                                else if (p.CurrentStockOnHand > 15)
                                {
                                    <span class="badge-pill-neutral text-dark">
                                        <i class="bi bi-info-circle me-1"></i> Normal
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-pill-coral">
                                        <i class="bi bi-exclamation-triangle me-1"></i> Reorder Alert
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
