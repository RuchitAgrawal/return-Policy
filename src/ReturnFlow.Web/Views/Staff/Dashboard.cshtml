@{
    ViewData["Title"] = "Operations Command Dashboard";
}

<div class="container-fluid px-lg-4 px-3 py-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-2">
        <div>
            <span class="fs-micro text-steel d-block mb-1">Warehouse Operations Command</span>
            <h1 class="heading-lg mb-0">RMA Triage & Stock Orchestration</h1>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="badge-pill-neutral font-mono small d-none d-lg-inline-flex align-items-center">
                <i class="bi bi-keyboard me-1 text-steel"></i> Shortcuts: [A] Approve • [R] Reject • [J/K] Rows • [/] Search
            </span>
            <button class="btn-minimax-tertiary" id="btnRefreshData">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
            <a href="/Staff/Inventory" class="btn-minimax-primary text-decoration-none">
                <i class="bi bi-box-seam me-1"></i> Stock Ledger
            </a>
        </div>
    </div>

    <!-- 4 Clean Editorial Stat Cells -->
    <div class="row g-3 mb-4" id="kpiRibbon">
        <div class="col-xl-3 col-sm-6">
            <div class="card-base h-100">
                <span class="fs-micro text-steel d-block mb-1">Active Claims In Queue</span>
                <div class="fw-bold font-mono" style="font-size: 2rem; line-height: 1.1;" id="kpiActiveRmas">--</div>
                <span class="small text-steel mt-1 d-block">Pending manual or audit review</span>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card-base h-100">
                <span class="fs-micro text-steel d-block mb-1">Gross Value at Risk</span>
                <div class="fw-bold font-mono text-danger" style="font-size: 2rem; line-height: 1.1;" id="kpiValueAtRisk">₹--</div>
                <span class="small text-steel mt-1 d-block">Unapproved return claims</span>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card-base h-100">
                <span class="fs-micro text-steel d-block mb-1">Auto-Resolved Rate</span>
                <div class="fw-bold font-mono text-success" style="font-size: 2rem; line-height: 1.1;" id="kpiAutoResolved">--%</div>
                <span class="small text-steel mt-1 d-block">Zero-touch auto approvals</span>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="card-base h-100">
                <span class="fs-micro text-steel d-block mb-1">Sellable Stock on Hand</span>
                <div class="fw-bold font-mono" style="font-size: 2rem; line-height: 1.1;" id="kpiStockRecovered">--</div>
                <span class="small text-steel mt-1 d-block">Units across catalog</span>
            </div>
        </div>
    </div>

    <!-- Feature 3: Minimalist Chart.js Analytics Grid (Monochrome + Accent Palette) -->
    <div class="row g-3 mb-4">
        <!-- Chart 1: Defect Category Breakdown (Donut) -->
        <div class="col-lg-5 col-md-12">
            <div class="card-base h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fs-micro text-steel">Defect Category Distribution</span>
                    <span class="badge-pill-neutral font-mono" style="font-size: 11px;">Aggregated</span>
                </div>
                <div style="height: 200px; position: relative;">
                    <canvas id="defectCategoryChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Chart 2: Value at Risk by Sales Channel (Bar) -->
        <div class="col-lg-7 col-md-12">
            <div class="card-base h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fs-micro text-steel">Financial Risk by Channel</span>
                    <span class="badge-pill-neutral font-mono" style="font-size: 11px;">INR Exposure</span>
                </div>
                <div style="height: 200px; position: relative;">
                    <canvas id="channelRiskChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Strip: Segmented Pill Tabs & Search -->
    <div class="card-base p-3 mb-3">
        <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">
            <!-- Segmented Pill Tabs for Status -->
            <div class="pill-tab-bar" id="statusPillTabs">
                <button type="button" class="pill-tab-item active" data-status="All">All Claims</button>
                <button type="button" class="pill-tab-item" data-status="PendingReview">Pending Review</button>
                <button type="button" class="pill-tab-item" data-status="AutoApproved">Auto Approved</button>
                <button type="button" class="pill-tab-item" data-status="StaffApproved">Staff Approved</button>
                <button type="button" class="pill-tab-item" data-status="QuarantinedForFraud">Quarantined for Fraud</button>
            </div>

            <!-- Search & Secondary Dropdowns -->
            <div class="d-flex flex-wrap align-items-center gap-2 w-100 w-lg-auto">
                <div class="input-group input-group-sm" style="max-width: 260px;">
                    <span class="input-group-text bg-white border-end-0 text-steel"><i class="bi bi-search"></i></span>
                    <input type="text" id="filterSearchInput" class="form-control form-control-minimax border-start-0" placeholder="Search ticket, SKU, client..." style="height: 36px;" />
                </div>
                <select id="filterFraudSelect" class="form-select form-select-sm" style="height: 36px; max-width: 170px; font-size: 13px;">
                    <option value="All">All Fraud Levels</option>
                    <option value="High">High Risk Only</option>
                    <option value="Medium">Medium Risk</option>
                    <option value="Low">Low Risk</option>
                </select>
                <select id="filterChannelSelect" class="form-select form-select-sm" style="height: 36px; max-width: 170px; font-size: 13px;">
                    <option value="All">All Channels</option>
                    <option value="Shopify">Shopify</option>
                    <option value="AmazonIN">Amazon India</option>
                    <option value="B2BWholesale">B2B Wholesale</option>
                    <option value="DirectWeb">Direct Web</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Main Split-Pane Workspace -->
    <div class="row g-3">
        <!-- Table Column -->
        <div class="col-xl-7 col-lg-6" id="tableColumn">
            <div class="card-base p-0 overflow-hidden">
                <div class="table-responsive" style="max-height: 650px;">
                    <table class="table-minimax align-middle" id="rmaTable">
                        <thead>
                            <tr>
                                <th>Ticket #</th>
                                <th>Customer & Product</th>
                                <th>Channel</th>
                                <th>Status</th>
                                <th>Fraud Risk</th>
                                <th>Refund</th>
                                <th>Delivered</th>
                            </tr>
                        </thead>
                        <tbody id="rmaTableBody">
                            <tr>
                                <td colspan="7" class="text-center py-4 text-steel">
                                    <div class="spinner-border spinner-border-sm me-2"></div> Loading claims...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Inspector Split-Pane Column -->
        <div class="col-xl-5 col-lg-6" id="inspectorColumn">
            <div class="card-base p-4 sticky-top" style="top: 80px;" id="inspectorPanel">
                <!-- Empty Placeholder -->
                <div class="text-center py-5" id="inspectorPlaceholder">
                    <div class="text-steel mb-3" style="opacity: 0.35;">
                        <i class="bi bi-layout-sidebar-inset-reverse" style="font-size: 3rem;"></i>
                    </div>
                    <h6 class="fw-bold mb-1">Select a Claim to Inspect</h6>
                    <p class="text-steel small mb-0">Click any row in the table or press [J]/[K] to audit SQL relational facts and authorize inventory actions.</p>
                </div>

                <!-- Active Ticket Details -->
                <div class="d-none" id="inspectorDetails">
                    <div class="d-flex justify-content-between align-items-start pb-3 mb-3 border-bottom border-light-subtle">
                        <div>
                            <span class="badge-pill-neutral font-mono mb-1 d-inline-block" id="inspTicketNumber">RMA-0000</span>
                            <h5 class="fw-bold mb-0" id="inspProductName">Product Name</h5>
                            <span class="text-steel small" id="inspCustomerOrder">Customer • Order</span>
                        </div>
                        <span class="badge-pill-dark" id="inspStatusBadge">Status</span>
                    </div>

                    <!-- Split Details: SQL Facts vs AI Extraction -->
                    <div class="row g-3 mb-3">
                        <!-- Left: Relational Order Metadata -->
                        <div class="col-12 bg-light p-3 rounded-3">
                            <span class="fs-micro text-steel d-block mb-2">
                                <i class="bi bi-database me-1"></i> Relational SQL Facts
                            </span>
                            <div class="row g-2 small">
                                <div class="col-6">
                                    <span class="text-steel d-block">Delivered:</span>
                                    <span class="fw-semibold" id="inspDeliveredDate">--</span>
                                </div>
                                <div class="col-6">
                                    <span class="text-steel d-block">Days Since:</span>
                                    <span class="fw-semibold" id="inspDaysSince">--</span>
                                </div>
                                <div class="col-6">
                                    <span class="text-steel d-block">Return Window:</span>
                                    <span class="fw-semibold" id="inspReturnWindow">--</span>
                                </div>
                                <div class="col-6">
                                    <span class="text-steel d-block">Warranty Window:</span>
                                    <span class="fw-semibold" id="inspWarrantyWindow">--</span>
                                </div>
                                <div class="col-6">
                                    <span class="text-steel d-block">Eligible Refund:</span>
                                    <span class="fw-bold text-success font-mono" id="inspRefundAmount">₹0.00</span>
                                </div>
                                <div class="col-6">
                                    <span class="text-steel d-block">Restocking Fee:</span>
                                    <span class="fw-bold text-danger font-mono" id="inspRestockingFee">₹0.00</span>
                                </div>
                            </div>
                        </div>

                        <!-- Raw Complaint Box -->
                        <div class="col-12">
                            <label class="fs-micro text-steel d-block mb-1">
                                <i class="bi bi-chat-left-quote me-1"></i> Raw Customer Complaint
                            </label>
                            <div class="p-2.5 border rounded-3 bg-white small text-charcoal fst-italic" id="inspComplaintText"></div>
                        </div>

                        <!-- Right: AI Structured Extraction -->
                        <div class="col-12">
                            <span class="fs-micro text-steel d-block mb-2">
                                <i class="bi bi-cpu me-1"></i> AI Structured Triage
                            </span>
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <span class="badge-pill-dark" id="inspFraudBadge">Fraud: --</span>
                                <span class="badge-pill-neutral font-mono" id="inspCategoryBadge">Category: --</span>
                                <span class="badge-pill-neutral fw-semibold" id="inspActionBadge">Action: --</span>
                                <span class="badge-pill-dark" id="inspRoutingBadge">Routing: --</span>
                            </div>

                            <!-- Sentiment Score -->
                            <div class="mb-2">
                                <div class="d-flex justify-content-between small text-steel mb-1">
                                    <span>Customer Escalation Score:</span>
                                    <span class="fw-bold font-mono" id="inspSentimentScore">0/10</span>
                                </div>
                                <div class="sentiment-gauge-editorial">
                                    <div class="sentiment-fill-editorial" id="inspSentimentFill" style="width: 0%;"></div>
                                </div>
                            </div>

                            <div class="p-2.5 bg-light rounded-3 small text-charcoal mb-3" id="inspReasoningText"></div>
                        </div>

                        <!-- Editable Customer Email Draft -->
                        <div class="col-12">
                            <label class="fs-micro text-steel d-flex justify-content-between mb-1">
                                <span><i class="bi bi-envelope me-1"></i> Customer Communication (Editable)</span>
                                <span class="text-steel font-mono" style="font-size: 11px;">Structured Output</span>
                            </label>
                            <textarea class="form-control form-control-minimax font-mono small" id="inspEmailText" rows="3"></textarea>
                        </div>
                    </div>

                    <!-- Action Decision Buttons -->
                    <div class="d-flex flex-column gap-2 pt-2 border-top border-light-subtle">
                        <div class="d-flex gap-2">
                            <button class="btn-minimax-primary flex-grow-1" id="btnApproveSync" title="Keyboard: [A]">
                                <i class="bi bi-check-circle"></i>
                                <span>Approve & Sync [A]</span>
                            </button>
                            <button class="btn-minimax-secondary flex-grow-1" id="btnApplyRestocking">
                                <i class="bi bi-percent"></i>
                                <span>Apply 15% Fee</span>
                            </button>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn-minimax-danger-outline flex-grow-1" id="btnRejectClaim" title="Keyboard: [R]">
                                <i class="bi bi-x-circle me-1"></i> Reject Claim [R]
                            </button>
                            <button class="btn-minimax-tertiary" id="btnInspPrintLabel" title="View Carrier Shipping Slip">
                                <i class="bi bi-printer"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reusable Carrier Return Shipping Label Modal -->
<div class="modal fade" id="carrierLabelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 p-3" style="border-radius: 20px;">
            <div class="d-flex justify-content-between align-items-center mb-3 px-2">
                <span class="fs-micro text-steel">Reverse Logistics Manifest</span>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="carrier-label-sheet" id="printableCarrierSlip">
                <div class="carrier-header d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold mb-0" style="letter-spacing: -1px;">DELHIVERY EXPRESS</h4>
                        <span class="fs-micro text-uppercase">Priority Reverse Cargo</span>
                    </div>
                    <div class="text-end">
                        <span class="badge-pill-dark py-1 px-2 font-mono" id="labelRmaNumber">RMA-9002</span>
                    </div>
                </div>

                <div class="row g-2 small mb-2">
                    <div class="col-6">
                        <span class="text-steel fs-micro d-block">DELIVER TO HUB:</span>
                        <span class="fw-bold d-block">ReturnFlow Hub #4</span>
                        <span>Whitefield Logistics Park</span>
                        <span class="d-block">Bengaluru, KA 560066</span>
                    </div>
                    <div class="col-6 border-start ps-2">
                        <span class="text-steel fs-micro d-block">PICKUP FROM:</span>
                        <span class="fw-bold d-block" id="labelCustomerName">TechCorp India</span>
                        <span class="d-block" id="labelOrderRef">Order ORD-2026-1003</span>
                        <span class="text-steel fs-micro">Authorized Return</span>
                    </div>
                </div>

                <div class="p-2 bg-light border border-dark rounded-2 small mb-2">
                    <div class="d-flex justify-content-between">
                        <span class="text-steel">Product:</span>
                        <span class="fw-bold font-mono" id="labelProductSku">SKU-DOCK-TB4</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-steel">Routing:</span>
                        <span class="fw-bold text-uppercase" id="labelRoutingAction">SEND TO REFURBISH</span>
                    </div>
                </div>

                <!-- Code-128 SVG Barcode Representation -->
                <div class="carrier-barcode-zone">
                    <svg width="280" height="50" viewBox="0 0 280 50" xmlns="http://www.w3.org/2000/svg">
                        <rect x="0" y="0" width="4" height="50" fill="#000" />
                        <rect x="8" y="0" width="2" height="50" fill="#000" />
                        <rect x="14" y="0" width="6" height="50" fill="#000" />
                        <rect x="24" y="0" width="2" height="50" fill="#000" />
                        <rect x="30" y="0" width="4" height="50" fill="#000" />
                        <rect x="38" y="0" width="8" height="50" fill="#000" />
                        <rect x="50" y="0" width="2" height="50" fill="#000" />
                        <rect x="56" y="0" width="6" height="50" fill="#000" />
                        <rect x="66" y="0" width="4" height="50" fill="#000" />
                        <rect x="74" y="0" width="2" height="50" fill="#000" />
                        <rect x="80" y="0" width="8" height="50" fill="#000" />
                        <rect x="92" y="0" width="4" height="50" fill="#000" />
                        <rect x="100" y="0" width="6" height="50" fill="#000" />
                        <rect x="110" y="0" width="2" height="50" fill="#000" />
                        <rect x="116" y="0" width="4" height="50" fill="#000" />
                        <rect x="124" y="0" width="8" height="50" fill="#000" />
                        <rect x="136" y="0" width="2" height="50" fill="#000" />
                        <rect x="142" y="0" width="6" height="50" fill="#000" />
                        <rect x="152" y="0" width="4" height="50" fill="#000" />
                        <rect x="160" y="0" width="2" height="50" fill="#000" />
                        <rect x="166" y="0" width="8" height="50" fill="#000" />
                        <rect x="178" y="0" width="4" height="50" fill="#000" />
                        <rect x="186" y="0" width="6" height="50" fill="#000" />
                        <rect x="196" y="0" width="2" height="50" fill="#000" />
                        <rect x="202" y="0" width="4" height="50" fill="#000" />
                        <rect x="210" y="0" width="8" height="50" fill="#000" />
                        <rect x="222" y="0" width="4" height="50" fill="#000" />
                        <rect x="230" y="0" width="6" height="50" fill="#000" />
                        <rect x="240" y="0" width="2" height="50" fill="#000" />
                        <rect x="246" y="0" width="6" height="50" fill="#000" />
                        <rect x="256" y="0" width="4" height="50" fill="#000" />
                        <rect x="264" y="0" width="8" height="50" fill="#000" />
                    </svg>
                    <span class="font-mono fs-micro d-block mt-1" id="labelBarcodeText">*DEL-RMA-9002-EXPEDITED*</span>
                </div>

                <div class="d-flex justify-content-between align-items-center fs-micro text-steel">
                    <span>TRACKING: DEL99214482IN</span>
                    <span>WEIGHT: 1.85 KG</span>
                    <span>STANDARD REVERSE CARGO</span>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-end mt-3">
                <button type="button" class="btn-minimax-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn-minimax-primary" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Print Label
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/staff-dashboard.js" asp-append-version="true"></script>
}
